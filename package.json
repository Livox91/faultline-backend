{
  "name": "faultline",
  "version": "0.1.0",
  "private": true,
  "description": "Kubernetes production diagnostics platform foundation",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "start:api": "npm run start --workspace=@faultline/api",
    "start:ingestion": "npm run start --workspace=@faultline/ingestion",
    "start:processor": "npm run start --workspace=@faultline/processor",
    "dev:api": "npm run build && concurrently -k \"tsc -b --watch\" \"node --watch apps/api/dist/main.js\"",
    "dev:ingestion": "npm run build && concurrently -k \"tsc -b --watch\" \"node --watch apps/ingestion/dist/main.js\"",
    "dev:processor": "npm run build && concurrently -k \"tsc -b --watch\" \"node --watch apps/processor/dist/main.js\"",
    "test": "npm run build && node --test tests/*.test.cjs",
    "dev:pipeline": "npm run build && node scripts/dev-pipeline.cjs",
    "telemetry:sample": "node scripts/sample-telemetry.cjs",
    "verify:kubernetes": "node scripts/verify-kubernetes.cjs",
    "validate:collector": "node scripts/validate-collector.cjs",
    "verify:metrics": "node scripts/verify-metrics.cjs",
    "infra:up": "docker compose --env-file .env.infrastructure -f compose.infrastructure.yml up -d --wait",
    "infra:down": "docker compose --env-file .env.infrastructure -f compose.infrastructure.yml down",
    "db:migrate": "npm run build --workspace=@faultline/database && npm run migration:apply --workspace=@faultline/database",
    "db:rollback": "npm run build --workspace=@faultline/database && npm run migration:rollback --workspace=@faultline/database",
    "db:migration:create": "npm run build --workspace=@faultline/database && npm run migration:create --workspace=@faultline/database --",
    "test:integration": "npm run build && node --test tests/infrastructure.test.cjs tests/clickhouse.test.cjs",
    "start:storage": "npm run start --workspace=@faultline/storage",
    "dev:storage": "npm run build && concurrently -k \"tsc -b --watch\" \"node --watch apps/storage/dist/main.js\"",
    "telemetry:schema": "npm run build --workspace=@faultline/clickhouse && npm run schema:apply --workspace=@faultline/clickhouse",
    "telemetry:retention": "npm run build --workspace=@faultline/clickhouse && node packages/clickhouse/dist/schema-cli.js retention",
    "telemetry:clear": "npm run build --workspace=@faultline/clickhouse && npm run schema:truncate --workspace=@faultline/clickhouse",
    "test:clickhouse": "npm run build && node --test tests/clickhouse.test.cjs",
    "setup": "node scripts/setup.cjs",
    "preflight": "node scripts/preflight.cjs",
    "infra:init": "node scripts/bootstrap-infrastructure.cjs",
    "faultline:start": "node scripts/faultline-start.cjs",
    "faultline:stop": "node scripts/faultline-stop.cjs",
    "faultline:restart": "npm run faultline:stop && npm run faultline:start",
    "cluster:add": "node scripts/cluster.cjs add",
    "cluster:install": "node scripts/cluster.cjs install",
    "cluster:verify": "node scripts/cluster.cjs verify",
    "cluster:onboard": "node scripts/cluster.cjs onboard",
    "onboarding:test:cleanup": "node scripts/cluster.cjs cleanup",
    "cluster:uninstall": "node scripts/cluster.cjs uninstall",
    "dev:reset": "node scripts/reset-development.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^9.2.1",
    "prettier": "3.9.6",
    "typescript": "~5.9.3"
  }
}
