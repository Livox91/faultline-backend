{
  "name": "faultline",
  "version": "0.1.0",
  "private": true,
  "description": "Kubernetes production diagnostics platform foundation",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "start:api": "npm run start --workspace=@faultline/api",
    "start:ingestion": "npm run start --workspace=@faultline/ingestion",
    "start:processor": "npm run start --workspace=@faultline/processor",
    "dev:api": "npm run build && concurrently -k \"tsc -b --watch\" \"node --watch apps/api/dist/main.js\"",
    "dev:ingestion": "npm run build && concurrently -k \"tsc -b --watch\" \"node --watch apps/ingestion/dist/main.js\"",
    "dev:processor": "npm run build && concurrently -k \"tsc -b --watch\" \"node --watch apps/processor/dist/main.js\"",
    "test": "npm run build && node --test tests/*.test.cjs",
    "dev:pipeline": "npm run build && node scripts/dev-pipeline.cjs",
    "telemetry:sample": "node scripts/sample-telemetry.cjs",
    "verify:kubernetes": "node scripts/verify-kubernetes.cjs",
    "validate:collector": "node scripts/validate-collector.cjs",
    "verify:metrics": "node scripts/verify-metrics.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^9.2.1",
    "prettier": "3.9.6",
    "typescript": "~5.9.3"
  }
}
