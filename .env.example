# Faultline onboarding defaults. `npm run setup` generates service-specific `.env`
# files and development-only secrets; this file is documentation and is never loaded.

# Customer cluster identity and the workload Faultline should confirm is present.
FAULTLINE_CLUSTER_ID=booknest-development
FAULTLINE_CLUSTER_NAME=BookNest local cluster
BOOKNEST_NAMESPACE=default
BOOKNEST_LABEL=app=booknest-backend

# URL reachable from pods. Use host.docker.internal for Docker Desktop/kind,
# host.minikube.internal for Minikube, or an HTTPS hostname/IP for remote clusters.
FAULTLINE_INGESTION_ENDPOINT=http://host.docker.internal:3001

# Generated by setup; never commit the resulting value.
FAULTLINE_DEV_AGENT_TOKEN=<generated-development-token>

# Faultline applications.
NODE_ENV=development
APP_VERSION=0.1.0
API_PORT=3000
INGESTION_PORT=3001
PROCESSOR_PORT=3002
STORAGE_PORT=3003
NOTIFICATION_PORT=3004

# Notification worker. Credentials and phone numbers are service-local secrets.
RETELL_API_KEY=<retell-api-key>
RETELL_FROM_NUMBER=<e164-number>
RETELL_VOICE_AGENT_ID=<voice-agent-id>
RETELL_SMS_AGENT_ID=<chat-agent-id>
NOTIFICATION_ORGANIZATION_ID=default
NOTIFICATION_SCHEDULER_POLL_MS=5000
NOTIFICATION_SCHEDULER_LEASE_MS=30000
NOTIFICATION_STALE_ATTEMPT_MS=300000
NOTIFICATION_ATTEMPT_RETENTION_DAYS=90
NOTIFICATION_AUDIT_RETENTION_DAYS=365

# Docker Compose infrastructure. Passwords are generated by setup.
POSTGRES_USER=faultline
POSTGRES_PASSWORD=<generated-postgres-password>
POSTGRES_DB=faultline
POSTGRES_PORT=5432
REDIS_PORT=6379
NATS_PORT=4222
NATS_MONITOR_PORT=8222
CLICKHOUSE_USER=faultline
CLICKHOUSE_PASSWORD=<generated-clickhouse-password>
CLICKHOUSE_DB=faultline
CLICKHOUSE_HTTP_PORT=8123

# Derived service connections written to apps/*/.env.
DATABASE_URL=postgresql://faultline:<password>@127.0.0.1:5432/faultline
REDIS_URL=redis://127.0.0.1:6379
BROKER_URL=nats://127.0.0.1:4222
CLICKHOUSE_URL=http://127.0.0.1:8123

# --- Authentication and authorization -------------------------------------
# Signs the access tokens the API issues. Required for the API outside tests.
# Rotate by replacing it: every existing token stops verifying, which logs everyone out.
AUTH_JWT_SECRET=replace-with-48-random-bytes-base64url
# The `iss` claim written and required on every token.
AUTH_TOKEN_ISSUER=faultline
# How long an access token stays valid, in seconds.
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# Demand a second factor after the password. Leave false until an MFA provider is wired:
# with it on and no provider, login answers 503 by design rather than skipping the check.
AUTH_MFA_REQUIRED=false
# Seeds the first Admin, and only while the users table is empty. Unset both once you
# have signed in and changed the password - an env file is not a credential store.
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@faultline.local
AUTH_BOOTSTRAP_ADMIN_PASSWORD=change-this-password-now

# --- Public subscription purchase ------------------------------------------
# Turns the public checkout and webhook routes on. With this false they are not
# registered at all, so there is no public account-creating surface.
BILLING_ENABLED=false
# Server-side Stripe secret key. Never reaches the browser.
STRIPE_SECRET_KEY=sk_test_...
# Signing secret for the webhook endpoint. Without it a webhook cannot be verified,
# and an unverified webhook is just an anonymous request asking us to create an Admin.
STRIPE_WEBHOOK_SECRET=whsec_...
# The Stripe Price each self-serve tier is sold at. Basic is free, but it is still a
# recurring price of zero at Stripe, so every tier provisions through one signed path.
STRIPE_PRICE_ID_BASIC=price_...
STRIPE_PRICE_ID_PRO=price_...
# Where Enterprise enquiries go. Optional; shown on the pricing page as a mailto.
BILLING_SALES_CONTACT=sales@example.com
# Where the customer's browser reaches the web app: used for checkout return URLs
# and the sign-in link in the credentials email.
APP_PUBLIC_URL=http://localhost:5173
APP_NAME=Faultline

# --- Outbound email ---------------------------------------------------------
# `smtp` sends; `log` records to the application log. Configuration validation
# refuses `log` for a production deployment that has billing enabled.
EMAIL_TRANSPORT=log
EMAIL_FROM=Faultline <no-reply@faultline.local>
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USERNAME=
#SMTP_PASSWORD=
