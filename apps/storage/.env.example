# Required in every environment; supply the deployed release version in production.
NODE_ENV=development
APP_VERSION=0.1.0

# Optional: these are the defaults for storage.
HOST=0.0.0.0
PORT=3003
LOG_LEVEL=log

BROKER_URL=nats://127.0.0.1:4222
BROKER_CLIENT_ID=faultline
BROKER_CONSUMER_GROUP=faultline-processors
# A separate durable consumer gives telemetry storage its own cursor and failure domain,
# so a ClickHouse outage retries here without slowing or stopping the processor. It must
# differ from BROKER_CONSUMER_GROUP, or the two would split the subject instead.
TELEMETRY_STORAGE_CONSUMER_GROUP=faultline-telemetry-storage
# Storage tolerates a longer outage than the processor before dead-lettering.
BROKER_MAX_DELIVER=10
BROKER_RETRY_DELAY_MS=5000

CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_DATABASE=faultline
CLICKHOUSE_USERNAME=faultline
CLICKHOUSE_PASSWORD=replace-with-a-local-secret
CLICKHOUSE_REQUEST_TIMEOUT_MS=30000

# Batching: flush at whichever bound is reached first.
TELEMETRY_BATCH_MAX_SIZE=500
TELEMETRY_BATCH_MAX_AGE_MS=2000

# Retention in days. Must match the values used when the schema was applied.
TELEMETRY_RETENTION_LOGS_DAYS=7
TELEMETRY_RETENTION_METRICS_DAYS=14
TELEMETRY_RETENTION_KUBERNETES_EVENTS_DAYS=30

# Oversized telemetry is truncated, never dropped. See docs/TELEMETRY-STORAGE.md.
TELEMETRY_MAX_MESSAGE_BYTES=32768
TELEMETRY_MAX_RAW_PAYLOAD_BYTES=65536
TELEMETRY_MAX_ATTRIBUTE_VALUE_BYTES=4096
TELEMETRY_MAX_ATTRIBUTE_COUNT=128
