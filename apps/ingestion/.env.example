# Required in every environment; supply the deployed release version in production.
NODE_ENV=development
APP_VERSION=0.1.0

# Optional: these are the defaults for ingestion.
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=log

# Development only. Replace with your local secret; never commit actual credentials.
FAULTLINE_DEV_AGENT_TOKEN=change-me-local-only
