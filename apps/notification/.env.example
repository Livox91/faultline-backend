NODE_ENV=development
APP_VERSION=0.1.0
PORT=3004
DATABASE_URL=postgresql://faultline:replace-with-a-local-secret@127.0.0.1:5432/faultline
BROKER_URL=nats://127.0.0.1:4222
RETELL_API_KEY=<secret>
RETELL_FROM_NUMBER=<e164-number>
RETELL_VOICE_AGENT_ID=<agent-id>
RETELL_SMS_AGENT_ID=<chat-agent-id>
NOTIFICATION_ORGANIZATION_ID=default
NOTIFICATION_HIGH_ESCALATION_ENABLED=false
NOTIFICATION_CONSUMER_GROUP=faultline-notifications
NOTIFICATION_SCHEDULER_POLL_MS=5000
NOTIFICATION_SCHEDULER_LEASE_MS=30000
NOTIFICATION_STALE_ATTEMPT_MS=300000
NOTIFICATION_ATTEMPT_RETENTION_DAYS=90
NOTIFICATION_AUDIT_RETENTION_DAYS=365
SLACK_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_INCIDENT_CHANNEL_ID=
# Optional base URL used to link directly to /incidents/:incidentId
SLACK_DASHBOARD_URL=
# Optional JSON maps. Keys are normalized to lowercase.
SLACK_SERVICE_CHANNELS={}
SLACK_SERVICE_OWNERS={}
SLACK_TEAM_CHANNELS={}
