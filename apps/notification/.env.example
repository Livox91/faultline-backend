NODE_ENV=development
APP_VERSION=0.1.0
PORT=3004
BROKER_URL=nats://127.0.0.1:4222
RETELL_API_KEY=<secret>
RETELL_FROM_NUMBER=<e164-number>
RETELL_VOICE_AGENT_ID=<agent-id>
RETELL_SMS_AGENT_ID=<chat-agent-id>
NOTIFICATION_ORGANIZATION_ID=default
NOTIFICATION_SCHEDULER_POLL_MS=5000
NOTIFICATION_SCHEDULER_LEASE_MS=30000
NOTIFICATION_STALE_ATTEMPT_MS=300000
NOTIFICATION_ATTEMPT_RETENTION_DAYS=90
NOTIFICATION_AUDIT_RETENTION_DAYS=365
