# Required in every environment; supply the deployed release version in production.
NODE_ENV=development
APP_VERSION=0.1.0

# Optional: these are the defaults for api.
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=log

DATABASE_URL=postgresql://faultline:replace-with-a-local-secret@127.0.0.1:5432/faultline

CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_DATABASE=faultline
CLICKHOUSE_USERNAME=faultline
CLICKHOUSE_PASSWORD=replace-with-a-local-secret
CLICKHOUSE_REQUEST_TIMEOUT_MS=30000

# Query safety. Every telemetry read must name a cluster and a bounded window.
TELEMETRY_QUERY_MAX_RANGE_MS=86400000
TELEMETRY_QUERY_MAX_METRIC_RANGE_MS=604800000
TELEMETRY_QUERY_MAX_LIMIT=500
TELEMETRY_QUERY_DEFAULT_LIMIT=100
TELEMETRY_QUERY_TIMEOUT_MS=10000
TELEMETRY_QUERY_MIN_BUCKET_MS=1000
TELEMETRY_QUERY_MAX_BUCKETS=1000

# Clusters this deployment may query. Required in production; when unset outside
# production the API answers for every cluster, which is a development convenience only.
# TELEMETRY_QUERY_CLUSTER_SCOPE=development-cluster

# --- Authentication and authorization -------------------------------------
# Signs the access tokens the API issues. Required for the API outside tests.
# Rotate by replacing it: every existing token stops verifying, which logs everyone out.
AUTH_JWT_SECRET=replace-with-48-random-bytes-base64url
# The `iss` claim written and required on every token.
AUTH_TOKEN_ISSUER=faultline
# How long an access token stays valid, in seconds.
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# Demand a second factor after the password. Leave false until an MFA provider is wired:
# with it on and no provider, login answers 503 by design rather than skipping the check.
AUTH_MFA_REQUIRED=false
# Seeds the first Admin, and only while the users table is empty. Unset both once you
# have signed in and changed the password - an env file is not a credential store.
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@faultline.local
AUTH_BOOTSTRAP_ADMIN_PASSWORD=change-this-password-now
