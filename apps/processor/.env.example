# Required in every environment; supply the deployed release version in production.
NODE_ENV=development
APP_VERSION=0.1.0

# Optional: these are the defaults for processor.
HOST=0.0.0.0
PORT=3002
LOG_LEVEL=log

# Optional deterministic-rule thresholds.
ANOMALY_MEMORY_WARNING_PERCENT=85
ANOMALY_MEMORY_CRITICAL_PERCENT=95
ANOMALY_CPU_WARNING_PERCENT=80
ANOMALY_CPU_CRITICAL_PERCENT=95
ANOMALY_RESTART_THRESHOLD=3
ANOMALY_NOT_READY_DURATION_MS=60000
ANOMALY_DEPLOYMENT_DEGRADATION_DURATION_MS=120000
INCIDENT_CORRELATION_WINDOW_MS=600000
INCIDENT_STABILIZATION_PERIOD_MS=120000

DATABASE_URL=postgresql://faultline:replace-with-a-local-secret@127.0.0.1:5432/faultline
REDIS_URL=redis://127.0.0.1:6379
BROKER_URL=nats://127.0.0.1:4222
BROKER_CLIENT_ID=faultline
BROKER_CONSUMER_GROUP=faultline-processors
BROKER_MAX_DELIVER=5
BROKER_RETRY_DELAY_MS=1000
RESOURCE_STATE_TTL_MS=120000

# Optional staged log classifier. Deterministic rules run first; ML is only called
# for unmatched logs when an endpoint is configured.
LOG_CLASSIFIER_ENABLED=true
LOG_CLASSIFIER_MIN_CONFIDENCE=0.6
LOG_CLASSIFIER_HIGH_CONFIDENCE=0.85
LOG_CLASSIFIER_ML_TIMEOUT_MS=2000
LOG_CLASSIFIER_PATTERN_WINDOW_MS=600000
# LOG_CLASSIFIER_ML_URL=http://127.0.0.1:8080/classify
